# =============================================================================
# Pillow — environment configuration contract
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# Application
APP_ENV=development          # development | staging | production
APP_PORT=8080
APP_NAME=pillow

# PostgreSQL
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://pillow:secret@localhost:5432/pillow_dev?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=5

# Redis
# Format: redis://:password@host:port/db  (omit :password@ if no auth)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# JWT — RS256 asymmetric keys
# Generate:
#   openssl genrsa -out secrets/private.pem 4096
#   openssl rsa -in secrets/private.pem -pubout -out secrets/public.pem
JWT_PRIVATE_KEY_PATH=./secrets/private.pem
JWT_PUBLIC_KEY_PATH=./secrets/public.pem
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Google OAuth 2.0
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Rate limiting — sliding window counters stored in Redis
# Defaults shown are the production-safe values from AuthDesign.md §7.6
# Increase limits only after load testing confirms safe capacity.
RATELIMIT_LOGIN_IP_LIMIT=10
RATELIMIT_LOGIN_IP_WINDOW_SECONDS=60
RATELIMIT_LOGIN_EMAIL_LIMIT=5
RATELIMIT_LOGIN_EMAIL_WINDOW_SECONDS=900
RATELIMIT_REGISTER_IP_LIMIT=3
RATELIMIT_REGISTER_IP_WINDOW_SECONDS=60
RATELIMIT_REFRESH_IP_LIMIT=30
RATELIMIT_REFRESH_IP_WINDOW_SECONDS=60
RATELIMIT_OAUTH_IP_LIMIT=20
RATELIMIT_OAUTH_IP_WINDOW_SECONDS=60
